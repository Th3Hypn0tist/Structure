{
  "id": "3d.lighting.depth",
  "type": "structureprojector_3d_effect",
  "group": "lighting",
  "version": 1,
  "controls": [
    {"id": "depth_shadow", "label": "Depth shadow", "type": "range", "min": 0, "max": 1.5, "step": 0.05, "default": 0.65},
    {"id": "face_contrast", "label": "Face contrast", "type": "range", "min": 0, "max": 1.5, "step": 0.05, "default": 0.75}
  ],
  "style_targets": {"depth_shadow": "depth_shadow", "face_contrast": "face_contrast"},
  "renderer_contract": "Lighting changes visual depth only and never semantic state."
}
