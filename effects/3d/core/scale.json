{
  "id": "3d.core.scale",
  "type": "structureprojector_3d_effect",
  "group": "core",
  "version": 1,
  "controls": [
    {"id": "scale_x", "label": "X spread", "type": "range", "min": 0.35, "max": 2.8, "step": 0.05, "default": 1},
    {"id": "scale_y", "label": "Y spread", "type": "range", "min": 0.35, "max": 2.8, "step": 0.05, "default": 1},
    {"id": "scale_z", "label": "Z spread", "type": "range", "min": 0.35, "max": 2.8, "step": 0.05, "default": 1},
    {"id": "node_scale", "label": "Node size", "type": "range", "min": 0.55, "max": 1.8, "step": 0.05, "default": 1},
    {"id": "label_scale", "label": "Label size", "type": "range", "min": 0.65, "max": 1.6, "step": 0.05, "default": 1}
  ],
  "layout_targets": {"scale_x": "x", "scale_y": "y", "scale_z": "z"},
  "style_targets": {"node_scale": "node_scale", "label_scale": "label_scale"}
}
